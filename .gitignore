# ---- project data and outputs ------------------------------------------------
#
# Size policy. GitHub warns above 50 MiB per file and refuses the push above
# 100 MiB; both thresholds are the same on Free, Pro, Team and Enterprise Cloud
# (plan affects Git LFS quota, not the file-size ceiling). git also keeps every
# version of a binary forever, so a 60 MB raster committed a few times bloats the
# clone permanently even though no single copy trips a limit.
#
# .gitignore cannot express "larger than N", so the paths below are the explicit
# translation. Re-check as the data changes with:
#   git status --porcelain -uall | cut -c4- | xargs -r du -m 2>/dev/null | sort -rn | head
#
# Nothing currently tracked exceeds 100 MiB. The two entries in the 50-100 MiB
# band are both derived, so excluding them loses nothing irreplaceable.

# ArcticDEM mosaic tiles: ~4.5 GB of scaffolding, refetchable with download_dem()
ak_data/dem/

# Rebuilt by ak_fire.r from the tiles. 62 MB and 64 MB -- both over GitHub's
# 50 MiB warning threshold, and regenerable, so they do not belong in git.
# Listed by name rather than as ak_data/*.tif on purpose: a glob would also
# silently swallow ak_noislands_daymetpixels.tif, which predates this pipeline.
ak_data/ak_dem.tif
ak_data/ak_hillshade.tif

# Cached annual totals, rebuilt by get_annual_burned_area()
ak_data/derived/

# Local copy of the iLand project's processed summaries. Source of truth is
# //10.60.2.10/.../quinn_storage/iLand-visualisation-ai/data/processed/ --
# re-copy after any preprocess.R run there.
iland_data/

# Video frames are regenerated by ak_fire_anim.R; the encoded mp4/webm stay
render/frames/
